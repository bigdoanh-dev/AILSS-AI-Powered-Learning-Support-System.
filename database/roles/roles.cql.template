-- Password placeholders are substituted in-memory by bootstrap-cassandra.mjs.
CREATE ROLE IF NOT EXISTS cassandra_admin WITH LOGIN = true AND SUPERUSER = true AND PASSWORD = '{{CASSANDRA_ADMIN_PASSWORD}}';
CREATE ROLE IF NOT EXISTS cassandra_migrator WITH LOGIN = true AND SUPERUSER = false AND PASSWORD = '{{CASSANDRA_MIGRATOR_PASSWORD}}';
CREATE ROLE IF NOT EXISTS svc_identity WITH LOGIN = true AND SUPERUSER = false AND PASSWORD = '{{CASSANDRA_SVC_IDENTITY_PASSWORD}}';
CREATE ROLE IF NOT EXISTS svc_learning WITH LOGIN = true AND SUPERUSER = false AND PASSWORD = '{{CASSANDRA_SVC_LEARNING_PASSWORD}}';
CREATE ROLE IF NOT EXISTS svc_classroom WITH LOGIN = true AND SUPERUSER = false AND PASSWORD = '{{CASSANDRA_SVC_CLASSROOM_PASSWORD}}';
CREATE ROLE IF NOT EXISTS svc_assessment WITH LOGIN = true AND SUPERUSER = false AND PASSWORD = '{{CASSANDRA_SVC_ASSESSMENT_PASSWORD}}';
CREATE ROLE IF NOT EXISTS svc_interaction WITH LOGIN = true AND SUPERUSER = false AND PASSWORD = '{{CASSANDRA_SVC_INTERACTION_PASSWORD}}';
CREATE ROLE IF NOT EXISTS svc_ai WITH LOGIN = true AND SUPERUSER = false AND PASSWORD = '{{CASSANDRA_SVC_AI_PASSWORD}}';
CREATE ROLE IF NOT EXISTS svc_notification WITH LOGIN = true AND SUPERUSER = false AND PASSWORD = '{{CASSANDRA_SVC_NOTIFICATION_PASSWORD}}';
CREATE ROLE IF NOT EXISTS svc_audit WITH LOGIN = true AND SUPERUSER = false AND PASSWORD = '{{CASSANDRA_SVC_AUDIT_PASSWORD}}';
