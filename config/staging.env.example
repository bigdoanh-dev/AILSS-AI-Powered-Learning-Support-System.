# AILSS Phase 42 Revision C: Staging Configuration Contract Template
# Redacted fixture template. Do NOT commit live secrets or real cloud identifiers.

NODE_ENV=staging
AILSS_PROFILE=staging
PAYMENT_MODE=sepay

# Web and Gateway endpoints
AILSS_WEB_ORIGIN=https://staging.ailss.edu.vn
AILSS_GATEWAY_URL=https://api-staging.ailss.edu.vn
GOOGLE_WEB_CLIENT_ID=<INJECTED_WEB_CLIENT_ID>
GOOGLE_CLIENT_IDS=<INJECTED_WEB_CLIENT_ID>
APPLE_WEB_CLIENT_ID=<INJECTED_APPLE_SERVICES_ID>
APPLE_CLIENT_IDS=<INJECTED_APPLE_SERVICES_ID>
APPLE_WEB_REDIRECT_URI=https://staging.ailss.edu.vn/auth/login

# Password-reset OTP delivery (inject credentials from the deployment secret manager).
SMTP_HOST=<INJECTED>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<INJECTED>
SMTP_PASS=<INJECTED>
SMTP_FROM=<INJECTED>

# Identity & JWT
JWT_ISSUER=https://identity-staging.ailss.edu.vn
JWT_AUDIENCE=ailss-api
JWT_KID=<INJECTED>
JWT_PRIVATE_KEY_PATH=<INJECTED>
JWT_PUBLIC_KEY_PATH=<INJECTED>
SERVICE_TOKEN_PRIVATE_KEY_PATH=<INJECTED>
SERVICE_TOKEN_PUBLIC_KEY_PATH=<INJECTED>

# HTTPS / TLS Certificates
HTTPS_CERT_PATH=<INJECTED>
HTTPS_KEY_PATH=<INJECTED>

# Cassandra Connectivity
CASSANDRA_CONTACT_POINTS=<INJECTED>
CASSANDRA_LOCAL_DC=<INJECTED>
CASSANDRA_TLS_ENABLED=true
CASSANDRA_CA_PATH=<INJECTED>
CASSANDRA_USERNAME=<INJECTED>
CASSANDRA_PASSWORD=<INJECTED>

# RabbitMQ Connectivity
RABBITMQ_URL=<INJECTED>
RABBITMQ_TLS_ENABLED=true
RABBITMQ_USERNAME=<INJECTED>
RABBITMQ_PASSWORD=<INJECTED>

# Generic Object Storage (Documents)
OBJECT_STORAGE_ENDPOINT=<INJECTED>
OBJECT_STORAGE_PORT=443
OBJECT_STORAGE_USE_SSL=true
OBJECT_STORAGE_PUBLIC_URL=https://s3.ap-southeast-1.amazonaws.com
OBJECT_STORAGE_BUCKET=<INJECTED>
OBJECT_STORAGE_ACCESS_KEY=<INJECTED>
OBJECT_STORAGE_SECRET_KEY=<INJECTED>

# Media Subsystem Storage & Delivery
MEDIA_ENABLED=true
MEDIA_STORAGE_BUCKET=<INJECTED>
MEDIA_STORAGE_ACCESS_KEY=<INJECTED>
MEDIA_STORAGE_SECRET_KEY=<INJECTED>
MEDIA_PLAYBACK_SECRET=<INJECTED>
MEDIA_DELIVERY_ORIGIN=https://cdn-staging.ailss.edu.vn
MEDIA_ALLOWED_ORIGINS=https://staging.ailss.edu.vn
MEDIA_MAX_SOURCE_BYTES=10737418240
MEDIA_MAX_DURATION_SECONDS=14400
MEDIA_UPLOAD_TTL_SECONDS=3600
MEDIA_PROCESSING_TIMEOUT_MS=600000
MEDIA_RENDITION_HEIGHT=360
MEDIA_VIDEO_BITRATE=800000
MEDIA_PLAYBACK_TTL_SECONDS=120
MEDIA_TRANSCODE_PROFILES=<INJECTED>
MEDIA_QUOTA_LIMITS=<INJECTED>

# HMAC & Cursor Keys
PASSWORD_IDEMPOTENCY_HMAC_KEY=<INJECTED>
ADMIN_CURSOR_HMAC_KEY=<INJECTED>
LEARNING_CURSOR_HMAC_KEY=<INJECTED>
AI_CURSOR_HMAC_KEY=<INJECTED>
NOTIFICATION_TOKEN_SECRET=<INJECTED>
PLATFORM_TENANT_ID=00000000-0000-4000-8000-000000000001
