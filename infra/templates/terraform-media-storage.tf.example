# AILSS Phase 42 Revision C: Terraform / OpenTofu Infrastructure Template
# DO NOT apply autonomously. This is a local template for the DevOps engineer.

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

variable "aws_region" {
  type        = string
  default     = "ap-southeast-1"
  description = "Primary AWS region for AILSS media storage"
}

variable "media_bucket_name" {
  type        = string
  description = "Unique S3 bucket name for private media storage"
}

# 1. Private S3 Bucket with Block Public Access
resource "aws_s3_bucket" "media" {
  bucket = var.media_bucket_name

  tags = {
    Project     = "AILSS"
    Subsystem   = "Media"
    Environment = "production"
  }
}

resource "aws_s3_bucket_public_access_block" "media" {
  bucket = aws_s3_bucket.media.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_versioning" "media" {
  bucket = aws_s3_bucket.media.id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "media" {
  bucket = aws_s3_bucket.media.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

# 2. S3 Lifecycle Rules: Abort incomplete multipart uploads after 7 days
resource "aws_s3_bucket_lifecycle_configuration" "media" {
  bucket = aws_s3_bucket.media.id

  rule {
    id     = "abort-incomplete-multipart-uploads"
    status = "Enabled"

    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }
  }

  rule {
    id     = "expire-noncurrent-original-versions"
    status = "Enabled"

    filter {
      prefix = "media-original/"
    }

    noncurrent_version_expiration {
      noncurrent_days = 90
    }
  }
}

# 3. CloudFront Origin Access Control (OAC)
resource "aws_cloudfront_origin_access_control" "media_oac" {
  name                              = "ailss-media-oac"
  description                       = "OAC for AILSS private media delivery"
  origin_access_control_origin_type = "s3"
  signing_behavior                  = "always"
  signing_protocol                  = "sigv4"
}

# 4. S3 Bucket Policy: Enforce HTTPS & OAC Read Only
resource "aws_s3_bucket_policy" "media" {
  bucket = aws_s3_bucket.media.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "EnforceTLSRequestsOnly"
        Effect    = "Deny"
        Principal = "*"
        Action    = "s3:*"
        Resource = [
          aws_s3_bucket.media.arn,
          "${aws_s3_bucket.media.arn}/*"
        ]
        Condition = {
          Bool = {
            "aws:SecureTransport" = "false"
          }
        }
      }
    ]
  })
}

output "media_storage_bucket" {
  value       = aws_s3_bucket.media.bucket
  description = "Bucket name to set in MEDIA_STORAGE_BUCKET"
}

output "s3_endpoint" {
  value       = "s3.${var.aws_region}.amazonaws.com"
  description = "Endpoint to set in OBJECT_STORAGE_ENDPOINT"
}
