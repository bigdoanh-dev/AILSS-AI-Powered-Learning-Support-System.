{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBucketLocation",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::${MEDIA_STORAGE_BUCKET}"
    },
    {
      "Sid": "AllowPlaybackOutputRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::${MEDIA_STORAGE_BUCKET}/media-hls/*",
        "arn:aws:s3:::${MEDIA_STORAGE_BUCKET}/media-caption/*"
      ]
    }
  ]
}
