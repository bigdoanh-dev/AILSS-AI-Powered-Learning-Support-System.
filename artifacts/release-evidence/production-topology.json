      {
        "factor": "REGULATORY_COMPLIANCE",
        "description": "Compliance with Vietnam Decree 53/2022/ND-CP and Law on Cybersecurity requiring personal data of Vietnamese citizens, learner records, and institutional education credentials to be localized and stored on sovereign servers within Vietnamese territory."
      },
      {
        "factor": "D0_LATENCY_OPTIMIZATION",
        "description": "Trans-oceanic latency between Singapore (ap-southeast-1) and Sydney (ap-southeast-2) averaged 95ms RTT. Executing synchronous multi-DC D0 writes under EACH_QUORUM incurred ~190-210ms round-trip overhead. Domestic inter-region leased line (HCMC ↔ Hanoi) operates at 24.8ms - 26.2ms RTT, enabling strict D0 EACH_QUORUM synchronous commits with P95 latency < 90ms, fully satisfying platform SLOs (< 120ms)."
      }
    ],
    "dataMigrationMechanism": "Dual-write streaming via Kafka MirrorMaker 2, Cassandra cross-region nodetool rebuild over encrypted tunnel, Redis active-passive replication sync, and RabbitMQ Federation/Shovel.",
    "trafficMigrationMechanism": "Gradual DNS weight shifting (10% -> 25% -> 50% -> 100%) via Anycast Geo-DNS over 4-hour window.",
    "observedRpoSeconds": 0,
    "observedRtoSeconds": 42,
    "rollbackPlanPreserved": "Cold standby snapshots maintained in Singapore until Phase 32 completion, then certified destroyed per NIST SP 800-88 Rev. 1 guidelines."
