  "architectureModel": "OPTION_B_SEPARATE_CASSANDRA_NODES_TIER",
  "architectureRationale": "In Apache Cassandra, commitlog_sync is a node-level configuration in cassandra.yaml and cannot be configured per keyspace. To achieve true crash-durability (RPO=0) without forcing standard learning workloads (D1/D2) through expensive disk fsyncs, AILSS deploys a dedicated D0 Cassandra cluster (ailss-d0-cluster) operating with commitlog_sync=batch (2ms window) and Enterprise NVMe PLP hardware backing, separated from the general shared cluster (ailss-prod-cassandra, commitlog_sync=periodic, 10s).",
  "clusters": [
    {
      "clusterName": "ailss-d0-cluster",
      "tier": "D0_DEDICATED_STORAGE_TIER",
      "workloads": [
        "ASSESSMENT_SUBMIT",
        "GRADE_FINALIZE",
        "SECURITY_SESSION_REVOKE",
        "CREDENTIAL_REVOKE",
        "PAYMENT_CONFIRM",
        "REFUND_CONFIRM"
      ],
      "keyspace": "ailss_d0_journal",
      "replicationStrategy": "NetworkTopologyStrategy",
      "replicationFactors": {
        "vn-south-primary": 3,
        "vn-north-secondary": 3
      },
      "nodeLevelCommitLogPolicy": {
        "commitlogSync": "batch",
        "commitlogSyncBatchWindowInMs": null,
        "commitlogSyncGroupWindowInMs": null,
        "syncModeSemantics": "IMMEDIATE_FSYNC_BEFORE_ACK_ZERO_WINDOW",
        "commitlogSegmentSizeInMb": 32,
        "commitlogDirectory": "/var/lib/cassandra/commitlog",
        "dataDirectory": "/var/lib/cassandra/data",
        "diskFailurePolicy": "stop",
        "concurrentWrites": 64,
        "requestTimeoutInMs": 3000,
        "internodeEncryption": "all",
        "tlsVersion": "TLSv1.3"
      },
