EXPO_PUBLIC_AILSS_ENV=development
# Set a Gateway origin explicitly. iOS simulator: http://127.0.0.1:8080
# Android emulator: http://10.0.2.2:8080; physical device: http://<host-LAN-IP>:18080.
EXPO_PUBLIC_AILSS_API_BASE_URL=

# Google Web Client ID is read from the Gateway's existing GOOGLE_WEB_CLIENT_ID.
# iOS only: OAuth client ID for the app bundle identifier (needed for native URL scheme).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional: your Apple development team ID, retained when regenerating the iOS project.
AILSS_IOS_APPLE_TEAM_ID=
