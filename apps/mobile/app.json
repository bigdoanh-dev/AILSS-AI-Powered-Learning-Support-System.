{
  "expo": {
    "name": "AILSS",
    "slug": "ailss-mobile",
    "version": "14.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding-new/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.ailss.mobile",
      "buildNumber": "14100"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#060D20",
        "foregroundImage": "./assets/branding-new/adaptive-foreground.png",
        "monochromeImage": "./assets/branding-new/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.ailss.mobile",
      "versionCode": 14100
    },
    "web": {
      "favicon": "./assets/branding-new/icon.png"
    },
    "scheme": "ailss-mobile",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding-new/splash-logo.png",
          "backgroundColor": "#060D20",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
