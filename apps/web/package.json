{
  "name": "@ailss/web",
  "version": "12.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.tsx",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run && node --test server/session.test.mjs server/lecturer.test.mjs server/admin.test.mjs server/student-commerce.test.mjs server/local-library.test.mjs server/realtime.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:browser": "node scripts/verify-browser.mjs",
    "verify:phase40:revision-l": "node scripts/verify-phase40-revision-l.mjs",
    "assets": "node scripts/assets.mjs",
    "video": "node scripts/video.mjs"
  },
  "dependencies": {
    "hls.js": "1.6.19",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.3",
    "recharts": "^3.10.1",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.179.0",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "sharp": "0.34.3",
    "vite": "7.1.4"
  }
}
