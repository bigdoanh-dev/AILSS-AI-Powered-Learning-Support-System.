{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ailss.local/events/interaction.review.created.v1.schema.json",
  "title": "interaction.review.created.v1",
  "type": "object",
  "required": [
    "specVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "producer",
    "correlationId",
    "aggregate",
    "data"
  ],
  "properties": {
    "specVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "interaction.review.created.v1"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object"
    },
    "aggregate": {
      "type": "object",
      "required": ["type", "id", "version"],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "courseId", "rating", "version"],
      "properties": {
        "reviewId": { "type": "string", "format": "uuid" },
        "courseId": { "type": "string", "format": "uuid" },
        "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "additionalProperties": false
}
