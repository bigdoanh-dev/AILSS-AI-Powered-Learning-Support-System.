{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ailss.local/events/system.notification.requested.v1.schema.json",
  "title": "system.notification.requested.v1",
  "type": "object",
  "required": [
    "specVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "producer",
    "correlationId",
    "aggregate",
    "data"
  ],
  "properties": {
    "specVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "system.notification.requested.v1"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object"
    },
    "aggregate": {
      "type": "object",
      "required": ["type", "id", "version"],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipientId", "notificationType", "title", "body", "source"],
      "properties": {
        "recipientId": { "type": "string", "format": "uuid" },
        "notificationType": { "const": "CLASS_ANNOUNCEMENT" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "body": { "type": "string", "minLength": 1, "maxLength": 500 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["announcementId", "classId"],
          "properties": {
            "announcementId": { "type": "string", "format": "uuid" },
            "classId": { "type": "string", "format": "uuid" }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
