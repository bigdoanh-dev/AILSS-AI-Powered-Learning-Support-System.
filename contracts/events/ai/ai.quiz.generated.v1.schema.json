{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ailss.local/events/ai.quiz.generated.v1.schema.json",
  "title": "ai.quiz.generated.v1",
  "type": "object",
  "required": [
    "specVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "producer",
    "correlationId",
    "aggregate",
    "data"
  ],
  "properties": {
    "specVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "ai.quiz.generated.v1"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object"
    },
    "aggregate": {
      "type": "object",
      "required": ["type", "id", "version"],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "draftId",
        "draftVersion",
        "targetType",
        "targetId",
        "questionCount",
        "draftChecksum"
      ],
      "properties": {
        "jobId": { "type": "string", "format": "uuid" },
        "draftId": { "type": "string", "format": "uuid" },
        "draftVersion": { "const": 1 },
        "targetType": { "type": "string", "enum": ["COURSE", "CLASS"] },
        "targetId": { "type": "string", "format": "uuid" },
        "questionCount": { "type": "integer", "minimum": 1, "maximum": 50 },
        "draftChecksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "additionalProperties": false
}
