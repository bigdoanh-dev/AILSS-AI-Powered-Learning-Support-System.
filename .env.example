NODE_ENV=development
LOG_LEVEL=info
AILSS_PROFILE=dev-core
# The second Gateway port (18080) stays on loopback by default.
# For physical-device development, set this to the host's trusted LAN IPv4.
AILSS_MOBILE_GATEWAY_BIND_ADDRESS=127.0.0.1
JWT_ISSUER=https://identity.ailss.local
JWT_AUDIENCE=ailss-api
JWT_KID=dev-user-2026-01
JWT_PRIVATE_KEY_PATH=./infrastructure/tls/generated/identity/user-jwt-private.pem
JWT_PUBLIC_KEY_PATH=./infrastructure/tls/generated/identity/user-jwt-public.pem
JWT_CLOCK_SKEW_SECONDS=60
# Web/mobile Sign in with Google / Apple. Gateway shares GOOGLE_WEB_CLIENT_ID
# with mobile; Identity must accept that ID in GOOGLE_CLIENT_IDS. Apple uses a
# registered Services ID.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_IDS=
APPLE_WEB_CLIENT_ID=
APPLE_CLIENT_IDS=
APPLE_WEB_REDIRECT_URI=
ACTOR_CONTEXT_ISSUER=api-gateway
ACTOR_CONTEXT_AUDIENCE=identity-service
ACTOR_CONTEXT_PURPOSE=identity.logout
ACTOR_CONTEXT_KID=dev-gateway-2026-01
ACTOR_CONTEXT_TTL_SECONDS=30
ACTOR_CONTEXT_PRIVATE_KEY_PATH=./infrastructure/tls/generated/services/gateway-private.pem
ACTOR_CONTEXT_PUBLIC_KEY_PATH=./infrastructure/tls/generated/services/gateway-public.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_IDEMPOTENCY_HMAC_KEY=<INJECTED>
# SMTP is required for password-reset OTP email. Use TLS on port 465, or STARTTLS on 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_CURSOR_HMAC_KEY=<INJECTED>
AI_CURSOR_HMAC_KEY=<INJECTED>
AI_PROVIDER_MODE=production
AI_ADMIN_SUPPORT_MODE=external
# Browser URLs; internal Docker addresses are supplied by the observability overlay.
PROMETHEUS_PUBLIC_URL=http://127.0.0.1:9090
GRAFANA_PUBLIC_URL=http://127.0.0.1:3001
AI_PROVIDER_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_PROVIDER_MODEL=gpt-5-mini
AI_ASSISTANT_CACHE_TTL_SECONDS=86400
AI_ASSISTANT_CACHE_TENANT_ID=platform-default
# Supply an actual provider key in .env.local; the bootstrap must not generate one.
AI_PROVIDER_API_KEY=
SERVICE_TOKEN_TTL_SECONDS=60
IDENTITY_PUBLIC_PROFILE_DEADLINE_MS=500
CLASSROOM_OFFERING_CONTEXT_DEADLINE_MS=800
SERVICE_TOKEN_ISSUER=ailss-internal
SERVICE_TOKEN_AUDIENCE=identity-service
SERVICE_TOKEN_PURPOSE=identity.public-profile.read
SERVICE_TOKEN_KID=dev-learning-2026-01
SERVICE_KEYS_DIR=./infrastructure/tls/generated/services
CASSANDRA_IMAGE=cassandra:5.0.9@sha256:d35e159439b302146f964919904f84fd3c2cebf347272b8cb8c4368c1cf200e5
CASSANDRA_CONTACT_POINTS=127.0.0.1:9042
CASSANDRA_LOCAL_DC=ailss_dc
CASSANDRA_USERNAME=<INJECTED>
CASSANDRA_PASSWORD=<INJECTED>
CASSANDRA_TLS_ENABLED=false
CASSANDRA_CA_PATH=./infrastructure/tls/generated/ca/ca-cert.pem
CASSANDRA_TLS_SERVER_NAME=cassandra
CASSANDRA_ADMIN_USERNAME=<INJECTED>
CASSANDRA_ADMIN_PASSWORD=<INJECTED>
CASSANDRA_MIGRATOR_PASSWORD=<INJECTED>
CASSANDRA_SVC_IDENTITY_PASSWORD=<INJECTED>
CASSANDRA_SVC_LEARNING_PASSWORD=<INJECTED>
CASSANDRA_SVC_CLASSROOM_PASSWORD=<INJECTED>
CASSANDRA_SVC_ASSESSMENT_PASSWORD=<INJECTED>
CASSANDRA_SVC_INTERACTION_PASSWORD=<INJECTED>
CASSANDRA_SVC_AI_PASSWORD=<INJECTED>
CASSANDRA_SVC_NOTIFICATION_PASSWORD=<INJECTED>
CASSANDRA_SVC_AUDIT_PASSWORD=<INJECTED>
RABBITMQ_IMAGE=rabbitmq:4.1.8-management@sha256:51b2e9cbad14eb4a43dc77cf419d72dd5965e4204b9b4b1c1207dcfdc1d6f469
RABBITMQ_URL=amqp://127.0.0.1:5672/%2Failss
RABBITMQ_VHOST=/ailss
RABBITMQ_USERNAME=<INJECTED>
RABBITMQ_PASSWORD=<INJECTED>
RABBITMQ_TLS_ENABLED=false
RABBITMQ_ADMIN_USERNAME=<INJECTED>
RABBITMQ_ADMIN_PASSWORD=<INJECTED>
RABBITMQ_MQ_IDENTITY_PASSWORD=<INJECTED>
RABBITMQ_MQ_LEARNING_PASSWORD=<INJECTED>
RABBITMQ_MQ_CLASSROOM_PASSWORD=<INJECTED>
RABBITMQ_MQ_ASSESSMENT_PASSWORD=<INJECTED>
RABBITMQ_MQ_INTERACTION_PASSWORD=<INJECTED>
RABBITMQ_MQ_AI_SERVICE_PASSWORD=<INJECTED>
RABBITMQ_MQ_AI_WORKER_PASSWORD=<INJECTED>
RABBITMQ_MQ_DOCUMENT_WORKER_PASSWORD=<INJECTED>
RABBITMQ_MQ_NOTIFICATION_WORKER_PASSWORD=<INJECTED>
RABBITMQ_MQ_AUDIT_WORKER_PASSWORD=<INJECTED>
RABBITMQ_MQ_RECONCILE_WORKER_PASSWORD=<INJECTED>
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
OBJECT_STORAGE_ENDPOINT=127.0.0.1
# Browser-reachable origin used when signing lesson download/video URLs.
OBJECT_STORAGE_PUBLIC_URL=http://127.0.0.1:9000
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_BUCKET=ailss-documents
OBJECT_STORAGE_ACCESS_KEY=<INJECTED>
OBJECT_STORAGE_SECRET_KEY=<INJECTED>
HTTP_BODY_LIMIT=1mb
IDENTITY_SERVICE_URL=http://127.0.0.1:8101
LEARNING_SERVICE_URL=http://127.0.0.1:8102
CLASSROOM_SERVICE_URL=http://127.0.0.1:8103
ASSESSMENT_SERVICE_URL=http://127.0.0.1:8104
INTERNAL_HTTP_TIMEOUT_MS=5000
PASSWORD_CHANGE_HTTP_TIMEOUT_MS=20000
TRUST_PROXY_HOPS=0
IDENTITY_OUTBOX_POLL_MS=1000
RATE_LIMIT_READ_PER_MINUTE=300
RATE_LIMIT_GLOBAL_PER_MINUTE=1200
RATE_LIMIT_WRITE_PER_MINUTE=60
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN_MS=30000
AI_MAX_EXTRACTED_TEXT_BYTES=1048576
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

# SePay webhook: API key >=32 characters. Never expose this key to the web client.
SEPAY_WEBHOOK_API_KEY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK=

# Explicit Model B: simulation only on dev profiles; set sepay for bank runtime.
PAYMENT_MODE=simulation
